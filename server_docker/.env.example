# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_ROOT_USERNAME=schneaggchat_admin
MONGODB_ROOT_PASSWORD=change_me_strong_password

# ── Spring / Auth ──────────────────────────────────────────────────────────────
# HS512 secret — generate with: openssl rand -hex 64
JWT_SECRET=change_me_very_long_random_hex_secret
DEFAULTACCOUNT_PASSWORD=change_me_DefaultPass1!

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
EMAIL=your_app@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ── Apple Push Notifications (APNs) ───────────────────────────────────────────
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.example.schneaggchat

# ── Rate limiting (NEW) ────────────────────────────────────────────────────────
# Set to false to disable all rate limiting (not recommended in production).
RATE_LIMIT_ENABLED=true

# Comma-separated CIDRs of trusted reverse proxies (nginx, Cloudflare, etc.).
# The server only honours X-Real-IP / X-Forwarded-For headers from these ranges.
# Leave empty when the server is exposed directly (no proxy in front).
# Example behind nginx on the same host: RATE_LIMIT_TRUSTED_PROXIES=172.16.0.0/12
RATE_LIMIT_TRUSTED_PROXIES=172.16.0.0/12
